'use client';

import { useEffect, useState } from 'react';

// Force dynamic rendering to avoid SSR issues
export const dynamic = 'force-dynamic';

export default function Profile() {
  const [mounted, setMounted] = useState(false);

  // SSR guard
  useEffect(() => {
    setMounted(true);
  }, []);

  if (!mounted) {
    return (
      <div className='container mx-auto px-4 pt-24 pb-8 relative z-10'>
        <div className='flex justify-center items-center h-64'>
          <div className='animate-spin h-8 w-8 border-4 border-blue-500 border-t-transparent rounded-full'></div>
          <p className='ml-2 text-white'>Loading...</p>
        </div>
      </div>
    );
  }

  return (
    <div className='container mx-auto px-4 pt-24 pb-8 relative z-10'>
      <div className='max-w-5xl mx-auto'>
        <div className='bg-white/10 backdrop-blur-sm border border-purple-500/20 rounded-lg p-8'>
          <h1 className='text-3xl font-bold text-white mb-4'>Profile Page</h1>
          <p className='text-white/70'>This is a minimal profile page for testing.</p>
        </div>
      </div>
    </div>
  );
}
